apiVersion: v1
kind: Pod
metadata:
  name: evm-gpu-resource-probe
  namespace: evm-training
  labels:
    app.kubernetes.io/name: evm-gpu-resource-probe
    app.kubernetes.io/part-of: enterprise-vision-mlops
    evm.openai.local-runtime: docker-desktop-wsl2
spec:
  restartPolicy: Never
  securityContext:
    runAsNonRoot: true
    runAsUser: 10001
    runAsGroup: 10001
    seccompProfile:
      type: RuntimeDefault
  containers:
    - name: cuda
      image: nvidia/cuda:12.4.1-base-ubuntu22.04
      command: ["bash", "-lc"]
      args:
        - nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
      env:
        - name: LD_LIBRARY_PATH
          value: /usr/lib/wsl/drivers/nvidia-current:/usr/lib/wsl/lib
        - name: PATH
          value: /usr/lib/wsl/drivers/nvidia-current:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
      resources:
        requests:
          nvidia.com/gpu: "1"
        limits:
          nvidia.com/gpu: "1"
      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop:
            - ALL
      volumeMounts:
        - name: wsl-lib
          mountPath: /usr/lib/wsl/lib
          readOnly: true
        - name: wsl-driver
          mountPath: /usr/lib/wsl/drivers/nvidia-current
          readOnly: true
  volumes:
    - name: wsl-lib
      hostPath:
        path: /usr/lib/wsl/lib
        type: Directory
    - name: wsl-driver
      hostPath:
        path: __WSL_DRIVER_PATH__
        type: Directory

