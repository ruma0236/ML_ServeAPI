AIRFLOW_WEBSERVER_SECRET_KEY=evm-airflow-local-secret
AIRFLOW_UID=50000
EVM_GIT_COMMIT=
EVM_GIT_BRANCH=
EVM_AIRFLOW_TASK_RETRIES=1
EVM_AIRFLOW_RETRY_DELAY_MINUTES=2
EVM_AIRFLOW_TASK_TIMEOUT_MINUTES=10
EVM_AIRFLOW_DAG_TIMEOUT_MINUTES=45

# Jira schedule sync. Keep real API tokens outside Git.
JIRA_BASE_URL=https://<site>.atlassian.net
JIRA_EMAIL=<email>
JIRA_API_TOKEN=<api-token-from-mlops_key>
JIRA_PROJECT_KEY=SCRUM
JIRA_BOARD_ID=1
JIRA_EPIC_ISSUE_TYPE=에픽
JIRA_TASK_ISSUE_TYPE=작업
JIRA_SPRINT_PREFIX=EVM
JIRA_STATUS_TRANSITION_MAP={"Next":["Selected for Development","To Do"],"In Progress":["In Progress"],"Blocked":["Blocked"],"Done":["Done"]}
