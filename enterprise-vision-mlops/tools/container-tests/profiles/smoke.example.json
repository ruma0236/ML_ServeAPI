{
  "schema_version": "evm.container_test.profile.v1",
  "profile_id": "capacity-probe-low-load-smoke-example",
  "status": "NOT_RUN",
  "acceptance_credit": false,
  "blockers": [
    "frozen_actual_capacity_probe_catalog_input_required",
    "hash_bound_request_corpus_required",
    "ct_m04_runner_not_yet_bound"
  ],
  "target": {
    "network": "evm-local",
    "base_url": "http://evm-api:8000",
    "health_path": "/health",
    "catalog_path": "/control-panel/v1/scenario-workloads/capacity-probes",
    "predict_path": "/control-panel/v1/scenario-workloads/capacity-probes/predict",
    "authentication": {
      "mode": "none",
      "credentials_embedded": false
    }
  },
  "request_contract": {
    "schema_version": "evm.s3_capacity_probe_request.v1",
    "probe_family": "logistic",
    "feature_count": 28,
    "terminal_semantics": "synchronous_http_response",
    "job_status_polling": "not_applicable"
  },
  "frozen_inputs": {
    "catalog_path": "UNPROVISIONED_ACTUAL_CATALOG.json",
    "catalog_sha256": "UNPROVISIONED_ACTUAL_CATALOG_SHA256",
    "dataset_identity_sha256": "UNPROVISIONED_ACTUAL_DATASET_SHA256",
    "model_identity_sha256": "UNPROVISIONED_ACTUAL_MODEL_SHA256",
    "artifact_sha256": "UNPROVISIONED_ACTUAL_ARTIFACT_SHA256",
    "request_corpus_path": "UNPROVISIONED_ACTUAL_REQUEST_CORPUS.json",
    "request_corpus_sha256": "UNPROVISIONED_ACTUAL_REQUEST_CORPUS_SHA256"
  },
  "load": {
    "arrival_model": "closed_concurrency",
    "concurrency": 1,
    "maximum_request_count": 3,
    "maximum_duration_seconds": 60,
    "pacing_seconds": 20,
    "fixed_arrival_rate_claim": false,
    "claim_boundary": "At most three sequential requests with bounded pacing; not a fixed/open arrival-rate measurement."
  },
  "runtime_constraints": {
    "cpus": 1,
    "memory_mib": 512,
    "pids_limit": 128,
    "read_only_rootfs": true,
    "cap_drop": "ALL",
    "no_new_privileges": true,
    "runtime_user": "1000:1000",
    "code_mount": "read_only",
    "input_mount": "read_only",
    "output_mount": "write_only_by_contract"
  },
  "deferred_windows_gates": [
    {
      "gate_id": "windows_etw_collector",
      "status": "NOT_RUN"
    },
    {
      "gate_id": "windows_wsl_dual_collector",
      "status": "NOT_RUN"
    },
    {
      "gate_id": "windows_high_integrity_token",
      "status": "NOT_RUN"
    }
  ]
}
