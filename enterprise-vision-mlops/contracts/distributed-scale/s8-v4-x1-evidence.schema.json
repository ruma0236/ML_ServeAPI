{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evm.local/contracts/distributed-scale/s8-v4-x1-evidence.schema.json",
  "title": "S8-V4 X1 heterogeneous-model evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_item",
    "status",
    "acceptance_credit",
    "dependency",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": "evm.s8_v4.x1_experiment.v2"
    },
    "work_item": {
      "const": "X1"
    },
    "status": {
      "enum": ["planned", "running", "review_pending"]
    },
    "acceptance_credit": {
      "const": false
    },
    "reviewer_sign_off": {
      "enum": ["pending", "not_applicable"]
    },
    "dependency": {
      "type": ["object", "null"]
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run"
      }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "phase",
        "point_id",
        "run_index",
        "credit",
        "acceptance_credit",
        "model_ids"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": ["Q0", "P0", "P1", "CANDIDATE", "PROFILER", "HOT_GUARD", "P2", "P3", "P4", "P5"]
        },
        "point_id": {
          "type": "string",
          "minLength": 1
        },
        "run_index": {
          "type": "integer",
          "minimum": 1
        },
        "credit": {
          "enum": ["credit", "non_credit", "zero_credit"]
        },
        "acceptance_credit": {
          "const": false
        },
        "cuda_activity_observed": {
          "type": "boolean"
        },
        "cpu_fallback_observed": {
          "type": "boolean"
        },
        "model_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "higgs_logistic_regression",
              "higgs_gaussian_nb",
              "higgs_tiny_mlp",
              "criteo_dlrm_lite"
            ]
          }
        }
      }
    }
  }
}
