{
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "pattern": "^S[0-8]-AC-[0-9]{2}$",
          "title": "Criterion Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "criterion_id",
        "description",
        "status"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "ArchitectureDelta": {
      "additionalProperties": false,
      "properties": {
        "before": {
          "minLength": 1,
          "title": "Before",
          "type": "string"
        },
        "after": {
          "minLength": 1,
          "title": "After",
          "type": "string"
        },
        "selection_reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Selection Reasons",
          "type": "array"
        },
        "alternatives_and_tradeoffs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Alternatives And Tradeoffs",
          "type": "array"
        }
      },
      "required": [
        "before",
        "after",
        "selection_reasons",
        "alternatives_and_tradeoffs"
      ],
      "title": "ArchitectureDelta",
      "type": "object"
    },
    "ChangedComponent": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Files",
          "type": "array"
        }
      },
      "required": [
        "component",
        "files"
      ],
      "title": "ChangedComponent",
      "type": "object"
    },
    "ChronologicalUpdate": {
      "additionalProperties": false,
      "properties": {
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "phase": {
          "enum": [
            "design",
            "implementation",
            "experiment",
            "verification",
            "recovery"
          ],
          "title": "Phase",
          "type": "string"
        },
        "status": {
          "enum": [
            "planned",
            "implementing",
            "exercised",
            "verified",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "occurred_at",
        "phase",
        "status",
        "summary"
      ],
      "title": "ChronologicalUpdate",
      "type": "object"
    },
    "EvidenceArtifact": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "claim": {
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "generated_at",
        "claim"
      ],
      "title": "EvidenceArtifact",
      "type": "object"
    },
    "ExperimentContract": {
      "additionalProperties": false,
      "properties": {
        "preconditions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Preconditions",
          "type": "array"
        },
        "workload_input": {
          "minLength": 1,
          "title": "Workload Input",
          "type": "string"
        },
        "procedure": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Procedure",
          "type": "array"
        },
        "controlled_variables": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Controlled Variables",
          "type": "array"
        },
        "signals": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Signals",
          "type": "array"
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "stop_conditions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Stop Conditions",
          "type": "array"
        },
        "recovery_conditions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Recovery Conditions",
          "type": "array"
        },
        "existing_system_regression_required": {
          "const": true,
          "title": "Existing System Regression Required",
          "type": "boolean"
        },
        "lifecycle_e2e_regression_required": {
          "const": true,
          "title": "Lifecycle E2E Regression Required",
          "type": "boolean"
        }
      },
      "required": [
        "preconditions",
        "workload_input",
        "procedure",
        "controlled_variables",
        "signals",
        "acceptance_criteria",
        "stop_conditions",
        "recovery_conditions",
        "existing_system_regression_required",
        "lifecycle_e2e_regression_required"
      ],
      "title": "ExperimentContract",
      "type": "object"
    },
    "ImplementationDelta": {
      "additionalProperties": false,
      "properties": {
        "modified_existing_components": {
          "items": {
            "$ref": "#/$defs/ChangedComponent"
          },
          "title": "Modified Existing Components",
          "type": "array"
        },
        "compatibility": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Compatibility",
          "type": "array"
        },
        "migration": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Migration",
          "type": "array"
        }
      },
      "required": [
        "modified_existing_components",
        "compatibility",
        "migration"
      ],
      "title": "ImplementationDelta",
      "type": "object"
    },
    "VerdictAndClaimBoundary": {
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "not_run",
            "passed",
            "failed",
            "inconclusive",
            "blocked"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "claim_boundary": {
          "minLength": 1,
          "title": "Claim Boundary",
          "type": "string"
        },
        "final_system_validation_required": {
          "const": true,
          "title": "Final System Validation Required",
          "type": "boolean"
        }
      },
      "required": [
        "verdict",
        "claim_boundary",
        "final_system_validation_required"
      ],
      "title": "VerdictAndClaimBoundary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scenario_id": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3",
        "S4",
        "S5",
        "S6",
        "S7",
        "S8"
      ],
      "title": "Scenario Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "engineering_question": {
      "minLength": 1,
      "title": "Engineering Question",
      "type": "string"
    },
    "why_now": {
      "minLength": 1,
      "title": "Why Now",
      "type": "string"
    },
    "observed_gap": {
      "minLength": 1,
      "title": "Observed Gap",
      "type": "string"
    },
    "proposed_design": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Proposed Design",
      "type": "array"
    },
    "changed_components": {
      "items": {
        "$ref": "#/$defs/ChangedComponent"
      },
      "title": "Changed Components",
      "type": "array"
    },
    "implementation_summary": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Implementation Summary",
      "type": "array"
    },
    "experiment_environment": {
      "minLength": 1,
      "title": "Experiment Environment",
      "type": "string"
    },
    "test_or_experiment_steps": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Test Or Experiment Steps",
      "type": "array"
    },
    "acceptance_criteria": {
      "items": {
        "$ref": "#/$defs/AcceptanceCriterion"
      },
      "minItems": 1,
      "title": "Acceptance Criteria",
      "type": "array"
    },
    "observed_result": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Observed Result"
    },
    "evidence_artifacts": {
      "items": {
        "$ref": "#/$defs/EvidenceArtifact"
      },
      "title": "Evidence Artifacts",
      "type": "array"
    },
    "status": {
      "enum": [
        "planned",
        "implementing",
        "exercised",
        "verified",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "claim_boundary": {
      "minLength": 1,
      "title": "Claim Boundary",
      "type": "string"
    },
    "unresolved_items": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Items",
      "type": "array"
    },
    "next_action": {
      "minLength": 1,
      "title": "Next Action",
      "type": "string"
    },
    "architecture_before": {
      "minLength": 1,
      "title": "Architecture Before",
      "type": "string"
    },
    "architecture_after": {
      "minLength": 1,
      "title": "Architecture After",
      "type": "string"
    },
    "existing_system_baseline": {
      "minLength": 1,
      "title": "Existing System Baseline",
      "type": "string"
    },
    "affected_existing_components": {
      "items": {
        "$ref": "#/$defs/ChangedComponent"
      },
      "minItems": 1,
      "title": "Affected Existing Components",
      "type": "array"
    },
    "engineering_gap_and_reason": {
      "minLength": 1,
      "title": "Engineering Gap And Reason",
      "type": "string"
    },
    "architecture_delta": {
      "$ref": "#/$defs/ArchitectureDelta"
    },
    "implementation_delta": {
      "$ref": "#/$defs/ImplementationDelta"
    },
    "experiment_contract": {
      "$ref": "#/$defs/ExperimentContract"
    },
    "evidence_index": {
      "items": {
        "$ref": "#/$defs/EvidenceArtifact"
      },
      "title": "Evidence Index",
      "type": "array"
    },
    "verdict_and_claim_boundary": {
      "$ref": "#/$defs/VerdictAndClaimBoundary"
    },
    "chronological_updates": {
      "items": {
        "$ref": "#/$defs/ChronologicalUpdate"
      },
      "minItems": 1,
      "title": "Chronological Updates",
      "type": "array"
    },
    "schema_version": {
      "const": "evm.scale_validation.scenario_evidence.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "source_progress_ledger": {
      "title": "Source Progress Ledger",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "title",
    "engineering_question",
    "why_now",
    "observed_gap",
    "proposed_design",
    "changed_components",
    "implementation_summary",
    "experiment_environment",
    "test_or_experiment_steps",
    "acceptance_criteria",
    "observed_result",
    "evidence_artifacts",
    "status",
    "claim_boundary",
    "unresolved_items",
    "next_action",
    "architecture_before",
    "architecture_after",
    "existing_system_baseline",
    "affected_existing_components",
    "engineering_gap_and_reason",
    "architecture_delta",
    "implementation_delta",
    "experiment_contract",
    "evidence_index",
    "verdict_and_claim_boundary",
    "chronological_updates",
    "schema_version",
    "generated_at",
    "source_progress_ledger"
  ],
  "title": "ScenarioExecutionEvidence",
  "type": "object"
}
